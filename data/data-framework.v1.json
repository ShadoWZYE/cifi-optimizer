{
  "dataset": "repo-data-framework.v1",
  "updatedAt": "2026-04-18",
  "purpose": "Central system-level manifest for the DB-first architecture, mapping canonical data, boundaries, models, support inputs, and exported read models by system.",
  "targetState": {
    "goal": "Make app, trace, and planner code consume DB-backed system units and materialized views instead of narrow file-shaped intermediates.",
    "principles": [
      "Centralize data by the actual in-game system it belongs to.",
      "Keep canonical, boundary, model, support, and historical-probe roles explicit inside each system unit.",
      "Use DB-backed canonical/materialized state as runtime truth.",
      "Preserve old files only while they still serve as raw inputs, static exports, or deliberate reference/debug artifacts.",
      "Do not promote assumed or heuristic fields into canonical truth.",
      "When data is copied into a centralized unit, preserve verbose provenance and regeneration commands for transient derived inputs."
    ]
  },
  "roles": [
    {
      "id": "canonical",
      "label": "Canonical dataset",
      "description": "Grounded or app-consumed truth."
    },
    {
      "id": "boundary",
      "label": "Boundary dataset",
      "description": "Explicit blocker, unresolved seam, or checked negative result."
    },
    {
      "id": "model",
      "label": "Model dataset",
      "description": "Reusable structured evaluator or formula model."
    },
    {
      "id": "support",
      "label": "Support dataset",
      "description": "Shared descriptive or mapping support that is still grounded and intentionally reused."
    },
    {
      "id": "historical-probe",
      "label": "Historical reference input",
      "description": "Retained reference/debug source material slated for later archival or isolation once DB-backed and exported replacements are sufficient."
    }
  ],
  "migrationUnits": [
    {
