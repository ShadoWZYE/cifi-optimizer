{
  "dataset": "repo-data-framework.v1",
  "updatedAt": "2026-04-18",
  "purpose": "Central system-level migration manifest for consolidating probe-era data into explicit canonical, boundary, model, and support views without deleting original source files first.",
  "targetState": {
    "goal": "Make app, trace, and planner code consume centralized system units instead of individual probe files or narrow migration slices.",
    "principles": [
      "Centralize data by the actual in-game system it belongs to.",
      "Keep canonical, boundary, model, support, and historical-probe roles explicit inside each system unit.",
      "Preserve old files until every live read has been moved behind a centralized system unit.",
      "Do not promote assumed or heuristic fields into canonical truth.",
      "Treat probe-era files as source material until equivalent centralized projections exist.",
      "When data is copied into a centralized unit, preserve verbose provenance and regeneration commands for transient probe-derived inputs."
    ]
  },
  "roles": [
    {
      "id": "canonical",
      "label": "Canonical dataset",
      "description": "Grounded or app-consumed truth."
    },
    {
      "id": "boundary",
      "label": "Boundary dataset",
      "description": "Explicit blocker, unresolved seam, or checked negative result."
    },
    {
      "id": "model",
      "label": "Model dataset",
      "description": "Reusable structured evaluator or formula model."
    },
    {
      "id": "support",
      "label": "Support dataset",
      "description": "Shared descriptive or mapping support that is still grounded and intentionally reused."
    },
    {
      "id": "historical-probe",
      "label": "Historical probe input",
      "description": "Retained source material slated for later archival once centralized system units replace all live reads."
    }
  ],
  "migrationUnits": [
    {
      "id": "shards",
      "kind": "system",
      "status": "seeded",
      "domain": "shards",
      "subsystems": [
        "family",
        "owned-state",
        "cost"
      ],
      "targetDatasets": [
        "data/system-units/shards.v1.json"
      ],
      "appStatePaths": [
