{
  "name": "cifi-optimization-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25.8.1 <26"
  },
  "scripts": {
    "check:syntax": "node ./scripts/contracts/check-js-syntax.mjs",
    "capture:surface": "node ./scripts/ui/capture-local-surface.mjs",
    "ci:local": "npm run verify && npm test && npm run test:unit",
    "contracts:gen-index": "node ./scripts/contracts/generate-dataset-index.mjs",
    "dev": "node ./scripts/dev-server.mjs",
    "extract:build": "node ./scripts/unity/run_extract.mjs build",
    "extract:uabea": "node ./scripts/unity/run_extract.mjs uabea",
    "extract:asset": "node ./scripts/unity/run_extract.mjs asset",
    "extract:asset:run": "node ./scripts/unity/run_extract.mjs asset:run",
    "extract:trace": "node ./scripts/unity/run_extract.mjs trace",
    "format": "prettier --write \"package*.json\" \".prettierrc.json\" \".github/**/*.{md,yml,yaml}\" \"AGENTS.md\" \"CODEX_BRIEF.md\" \"README.md\" \"THIRD_PARTY_NOTICES.md\" \"app.js\" \"player-profile.js\" \"recommendation-contract.js\" \"support/*.js\" \"index.html\" \"styles.css\" \"scripts/**/*.mjs\" \"tests/**/*.{json,mjs}\"",
    "format:check": "prettier --check \"package*.json\" \".prettierrc.json\" \".github/**/*.{md,yml,yaml}\" \"AGENTS.md\" \"CODEX_BRIEF.md\" \"README.md\" \"THIRD_PARTY_NOTICES.md\" \"app.js\" \"player-profile.js\" \"recommendation-contract.js\" \"support/*.js\" \"index.html\" \"styles.css\" \"scripts/**/*.mjs\" \"tests/**/*.{json,mjs}\"",
    "lint": "eslint --max-warnings=0 \"app.js\" \"player-profile.js\" \"recommendation-contract.js\" \"support/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "lint:docs": "node ./scripts/contracts/lint-doc-portability.mjs",
    "shards:calibration-report": "node ./scripts/shards/calibration-report.mjs",
    "verify": "npm run verify:data && npm run verify:vendoring && npm run check:syntax && npm run lint:docs && npm run format:check && npm run lint",
    "verify:data": "node ./scripts/contracts/validate-datasets.mjs",
    "verify:vendoring": "node ./scripts/contracts/verify-vendoring-layout.mjs",
    "test": "node ./tests/smoke.mjs",
    "test:unit": "node ./scripts/tests/run-unit-tests.mjs"
  },
  "devDependencies": {
    "eslint": "^10.2.1",
    "playwright": "^1.59.1",
    "prettier": "^3.9.4"
  }
}
