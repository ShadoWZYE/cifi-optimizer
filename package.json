{
  "name": "cifi-optimization-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:syntax": "node ./scripts/contracts/check-js-syntax.mjs",
    "contracts:gen-index": "node ./scripts/contracts/generate-dataset-index.mjs",
    "dev": "node ./scripts/dev-server.mjs",
    "format": "prettier --write \"package*.json\" \".prettierrc.json\" \".github/**/*.{md,yml,yaml}\" \"AGENTS.md\" \"CODEX_BRIEF.md\" \"README.md\" \"THIRD_PARTY_NOTICES.md\" \"app.js\" \"import-normalization-support.js\" \"player-profile-boundary-support.js\" \"player-profile.js\" \"recommendation-contract.js\" \"recommendation-feed-support.js\" \"research-validation-support.js\" \"shard-boundary-summary-support.js\" \"shard-evidence-support.js\" \"ship-planner-support.js\" \"spend-boundary-summary.js\" \"index.html\" \"styles.css\" \"scripts/**/*.mjs\" \"tests/**/*.{json,mjs}\"",
    "format:check": "prettier --check \"package*.json\" \".prettierrc.json\" \".github/**/*.{md,yml,yaml}\" \"AGENTS.md\" \"CODEX_BRIEF.md\" \"README.md\" \"THIRD_PARTY_NOTICES.md\" \"app.js\" \"import-normalization-support.js\" \"player-profile-boundary-support.js\" \"player-profile.js\" \"recommendation-contract.js\" \"recommendation-feed-support.js\" \"research-validation-support.js\" \"shard-boundary-summary-support.js\" \"shard-evidence-support.js\" \"ship-planner-support.js\" \"spend-boundary-summary.js\" \"index.html\" \"styles.css\" \"scripts/**/*.mjs\" \"tests/**/*.{json,mjs}\"",
    "lint": "eslint --max-warnings=0 \"app.js\" \"import-normalization-support.js\" \"player-profile-boundary-support.js\" \"player-profile.js\" \"recommendation-contract.js\" \"recommendation-feed-support.js\" \"research-validation-support.js\" \"shard-boundary-summary-support.js\" \"shard-evidence-support.js\" \"ship-planner-support.js\" \"spend-boundary-summary.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "lint:docs": "node ./scripts/contracts/lint-doc-portability.mjs",
    "probe:build": "node ./scripts/unity/run_probe.mjs build",
    "probe:uabea": "node ./scripts/unity/run_probe.mjs uabea",
    "probe:shards:parameters": "node ./scripts/unity/run_probe.mjs shards:parameters",
    "probe:shards:type-metadata": "node ./scripts/unity/run_probe.mjs shards:type-metadata",
    "probe:shards:method": "node ./scripts/unity/run_probe.mjs shards:method",
    "probe:shards:cost-native": "node ./scripts/unity/run_probe.mjs shards:cost-native",
    "probe:trace": "node ./scripts/unity/run_probe.mjs trace",
    "shards:calibration-report": "node ./scripts/shards/calibration-report.mjs",
    "verify": "npm run verify:data && npm run verify:vendoring && npm run check:syntax && npm run lint:docs && npm run format:check && npm run lint",
    "verify:data": "node ./scripts/contracts/validate-datasets.mjs",
    "verify:vendoring": "node ./scripts/contracts/verify-vendoring-layout.mjs",
    "test": "node ./tests/smoke.mjs",
    "test:unit": "node ./scripts/tests/run-unit-tests.mjs"
  },
  "devDependencies": {
    "eslint": "^10.2.0",
    "prettier": "^3.8.2"
  }
}
